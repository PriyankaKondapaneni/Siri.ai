 "lines": [
  {
   "id": "h0",
   "who": "kabir",
   "kind": "note",
   "s": 0.25,
   "e": 1.915,
   "text": "Don't fall in love with me."
  },
  {
   "id": "n1",
   "who": "mira",
   "kind": "narr",
   "s": 2.465,
   "e": 7.757,
   "text": "Every night at 11:11… a stranger sends me a voice message."
  },
  {
   "id": "n2",
   "who": "mira",
   "kind": "narr",
   "s": 7.877,
   "e": 10.848,
   "text": "And everything he says comes true."
  },
  {
   "id": "k1",
   "who": "kabir",
   "kind": "note",
   "s": 11.268,
   "e": 18.134,
   "text": "Hey. Don't freak out. Tomorrow at 8:02, you'll spill your coffee. Wear the blue dress anyway."
  },
  {
   "id": "n3",
   "who": "mira",
   "kind": "narr",
   "s": 18.294,
   "e": 22.651,
   "text": "I deleted it. At 8:02… I spilled my coffee."
  },
  {
   "id": "k2",
   "who": "kabir",
   "kind": "note",
   "s": 23.071,
   "e": 26.38,
   "text": "The guy on the train will ask your name. Lie."
  },
  {
   "id": "n4",
   "who": "mira",
   "kind": "narr",
   "s": 26.54,
   "e": 30.702,
   "text": "He asked. I lied. My hands wouldn't stop shaking."
  },
  {
   "id": "k3",
   "who": "kabir",
   "kind": "note",
   "s": 31.122,
   "e": 38.199,
   "text": "Mira. Tomorrow, 6:40, Fifth Street. Stay on the curb. Promise me."
  },
  {
   "id": "n5",
   "who": "mira",
   "kind": "narr",
   "s": 38.359,
   "e": 43.183,
   "text": "6:40. A car ran the red light… and someone pulled me back."
  },
  {
   "id": "n6",
   "who": "mira",
   "kind": "narr",
   "s": 43.483,
   "e": 47.776,
   "text": "Dark eyes. A watch stopped at 11:11."
  },
  {
   "id": "k4",
   "who": "kabir",
   "kind": "live",
   "s": 47.896,
   "e": 49.428,
   "text": "Hey. You okay?"
  },
  {
   "id": "n7",
   "who": "mira",
   "kind": "narr",
   "s": 49.648,
   "e": 53.1,
   "text": "It was his voice. The one from my phone."
  },
  {
   "id": "k5",
   "who": "kabir",
   "kind": "live",
   "s": 53.22,
   "e": 54.967,
   "text": "Sorry... have we met?"
  },
  {
   "id": "n8",
   "who": "mira",
   "kind": "narr",
   "s": 55.147,
   "e": 57.9,
   "text": "He had no idea who I was."
  },
  {
   "id": "n9",
   "who": "mira",
   "kind": "narr",
   "s": 58.26,
   "e": 61.072,
   "text": "That night... one last message."
  },
  {
   "id": "k6",
   "who": "kabir",
   "kind": "note",
   "s": 61.492,
   "e": 65.865,
   "text": "If you've met me... I'm sorry. Don't fall in love with me."
  },
  {
   "id": "k7",
   "who": "kabir",
   "kind": "note",
   "s": 66.285,
   "e": 69.365,
   "text": "In seven days... I don't make it."
  }
 ]
}