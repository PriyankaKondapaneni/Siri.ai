 "lines": [
  {
   "id": "h0",
   "who": "kabir",
   "kind": "note",
   "s": 0.25,
   "e": 2.56,
   "text": "Don't let me get on the six-forty train."
  },
  {
   "id": "n1",
   "who": "mira",
   "kind": "narr",
   "s": 3.11,
   "e": 6.8,
   "text": "Six days. That's all his last message gave him."
  },
  {
   "id": "n2",
   "who": "mira",
   "kind": "narr",
   "s": 7.1,
   "e": 10.05,
   "text": "And he'd left his umbrella behind in the rain."
  },
  {
   "id": "n3",
   "who": "mira",
   "kind": "narr",
   "s": 10.35,
   "e": 16.54,
   "text": "A receipt in the strap. Same bakery. Same order. 6:20, every morning."
  },
  {
   "id": "n4",
   "who": "mira",
   "kind": "narr",
   "s": 16.84,
   "e": 22.19,
   "text": "People who buy bread at the same hour every day don't live far from where they buy it."
  }
 ]
