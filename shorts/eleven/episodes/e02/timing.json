 "lines": [
  {
   "id": "h0",
   "who": "kabir",
   "kind": "note",
   "s": 0.06,
   "e": 2.82,
   "text": "In seven days... I don't make it."
  },
  {
   "id": "n1",
   "who": "mira",
   "kind": "narr",
   "s": 3.37,
   "e": 4.56,
   "text": "Six days."
  },
  {
   "id": "n2",
   "who": "mira",
   "kind": "narr",
   "s": 4.78,
   "e": 9.9,
   "text": "He'd pulled me off that curb, caught his bus... and left his umbrella behind."
  },
  {
   "id": "n3",
   "who": "mira",
   "kind": "narr",
   "s": 10.12,
   "e": 14.87,
   "text": "A receipt in the strap. Same bakery, 6:20, every morning."
  },
  {
   "id": "n4",
   "who": "mira",
   "kind": "narr",
   "s": 15.09,
   "e": 20.44,
   "text": "People who buy bread at the same hour every day don't live far from where they buy it."
  },
  {
   "id": "n5",
   "who": "mira",
   "kind": "narr",
   "s": 20.89,
   "e": 28.02,
   "text": "So I walked every lane around it. Almost eleven, there he was. Waiting, like he knew."
  },
  {
   "id": "bm1",
   "who": "mira",
   "kind": "live",
   "s": 28.52,
   "e": 29.79,
   "text": "You left this."
  },
  {
   "id": "bk1",
   "who": "kabir",
   "kind": "live",
   "s": 30.01,
   "e": 33.57,
   "text": "You followed a bus in the rain. For an umbrella."
  },
  {
   "id": "bk3",
   "who": "kabir",
   "kind": "live",
   "s": 33.79,
   "e": 35.3,
   "text": "It was my brother's."
  },
  {
   "id": "bn1",
   "who": "mira",
   "kind": "narr",
   "s": 35.52,
   "e": 39.19,
   "text": "The name stitched inside the strap said Arjun."
  },
  {
   "id": "bk4",
   "who": "kabir",
   "kind": "live",
   "s": 39.41,
   "e": 41.73,
   "text": "You're soaked. I'll make tea."
  },
  {
   "id": "cn1",
   "who": "mira",
   "kind": "narr",
   "s": 42.43,
   "e": 46.07,
   "text": "A photograph, turned to face the wall."
  },
  {
   "id": "ck1",
   "who": "kabir",
   "kind": "live",
   "s": 46.29,
   "e": 47.32,
   "text": "Blue suits you."
  },
  {
   "id": "cn2",
   "who": "mira",
   "kind": "narr",
   "s": 47.62,
   "e": 53.31,
   "text": "He'd said that to me before. In a message. From a night he hasn't lived yet."
  },
  {
   "id": "en2",
   "who": "mira",
   "kind": "narr",
   "s": 54.11,
   "e": 57.83,
   "text": "Eleven eleven. A new message. From him."
  },
  {
   "id": "en3",
   "who": "mira",
   "kind": "narr",
   "s": 58.05,
   "e": 62.17,
   "text": "He was standing right in front of me. He hadn't touched his phone."
  }
 ]
}