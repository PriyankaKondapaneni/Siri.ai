 "lines": [
  {
   "id": "h0",
   "who": "kabir",
   "kind": "live",
   "s": 0.25,
   "e": 3.263,
   "text": "Mira... I've never recorded a single message."
  },
  {
   "id": "n1",
   "who": "mira",
   "kind": "narr",
   "s": 3.813,
   "e": 8.837,
   "text": "One day left. I finally asked him what future him knows."
  },
  {
   "id": "k1",
   "who": "kabir",
   "kind": "live",
   "s": 8.957,
   "e": 13.044,
   "text": "Mira... I've never recorded a single message. Not one."
  },
  {
   "id": "n2",
   "who": "mira",
   "kind": "narr",
   "s": 13.164,
   "e": 18.547,
   "text": "He showed me his phone. Nothing sent. Nothing at 11:11."
  },
  {
   "id": "k2",
   "who": "kabir",
   "kind": "live",
   "s": 18.667,
   "e": 23.005,
   "text": "And the ones in your voice... you didn't send those either. Did you?"
  },
  {
   "id": "n3",
   "who": "mira",
   "kind": "narr",
   "s": 23.125,
   "e": 25.641,
   "text": "I didn't. I never had."
  },
  {
   "id": "n4",
   "who": "mira",
   "kind": "narr",
   "s": 25.761,
   "e": 28.366,
   "text": "So who has been talking to us?"
  },
  {
   "id": "n5",
   "who": "mira",
   "kind": "narr",
   "s": 28.486,
   "e": 33.68,
   "text": "That night, we sat on his floor, my head on his shoulder. Waiting."
  },
  {
   "id": "n6",
   "who": "mira",
   "kind": "narr",
   "s": 33.98,
   "e": 35.523,
   "text": "11:10. 11:11."
  },
  {
   "id": "n7",
   "who": "mira",
   "kind": "narr",
   "s": 35.743,
   "e": 39.122,
   "text": "Both phones lit up. The same number."
  },
  {
   "id": "k3",
   "who": "kabir",
   "kind": "live",
   "s": 39.242,
   "e": 41.588,
   "text": "That's... that's Arjun's number."
  }
 ]
}