 "lines": [
  {
   "id": "h0",
   "who": "mira",
   "kind": "narr",
   "s": 0.25,
   "e": 2.96,
   "text": "From a night he hasn't lived yet."
  },
  {
   "id": "n1",
   "who": "mira",
   "kind": "narr",
   "s": 3.51,
   "e": 10.74,
   "text": "Two mugs on the rack, one never used. A photograph, turned to face the wall."
  },
  {
   "id": "k1",
   "who": "kabir",
   "kind": "live",
   "s": 11.04,
   "e": 12.24,
   "text": "Blue suits you."
  },
  {
   "id": "n2",
   "who": "mira",
   "kind": "narr",
   "s": 12.54,
   "e": 19.2,
   "text": "He'd said that to me before. In a message. From a night he hasn't lived yet."
  },
  {
   "id": "k2",
   "who": "kabir",
   "kind": "live",
   "s": 19.5,
   "e": 20.197,
   "text": "Sugar?"
  },
  {
   "id": "m1",
   "who": "mira",
   "kind": "live",
   "s": 20.497,
   "e": 21.207,
   "text": "No."
  },
  {
   "id": "k3",
   "who": "kabir",
   "kind": "live",
   "s": 21.507,
   "e": 23.547,
   "text": "Good. I don't have any."
  },
  {
   "id": "m2",
   "who": "mira",
   "kind": "live",
   "s": 23.847,
   "e": 25.607,
   "text": "Your watch has stopped."
  },
  {
   "id": "k4",
   "who": "kabir",
   "kind": "live",
   "s": 25.727,
   "e": 26.517,
   "text": "Has it."
  }
 ]
