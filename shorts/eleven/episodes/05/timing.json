 "lines": [
  {
   "id": "h0",
   "who": "kabir",
   "kind": "live",
   "s": 0.25,
   "e": 4.077,
   "text": "He died on the old bridge. At 11:11."
  },
  {
   "id": "n1",
   "who": "mira",
   "kind": "narr",
   "s": 4.627,
   "e": 8.931,
   "text": "I had to know why his watch stopped. So I asked."
  },
  {
   "id": "k1",
   "who": "kabir",
   "kind": "live",
   "s": 9.051,
   "e": 12.324,
   "text": "My brother, Arjun. Three years ago."
  },
  {
   "id": "k2",
   "who": "kabir",
   "kind": "live",
   "s": 12.444,
   "e": 16.271,
   "text": "He died on the old bridge. At 11:11."
  },
  {
   "id": "n2",
   "who": "mira",
   "kind": "narr",
   "s": 16.391,
   "e": 19.252,
   "text": "The same bridge. The same minute."
  },
  {
   "id": "k3",
   "who": "kabir",
   "kind": "live",
   "s": 19.372,
   "e": 22.236,
   "text": "He believed in signs. I never did."
  },
  {
   "id": "n3",
   "who": "mira",
   "kind": "narr",
   "s": 22.356,
   "e": 25.765,
   "text": "I held his hand. This time, he let me."
  },
  {
   "id": "n4",
   "who": "mira",
   "kind": "narr",
   "s": 25.885,
   "e": 28.486,
   "text": "Then he showed me a photo of Arjun."
  },
  {
   "id": "n5",
   "who": "mira",
   "kind": "narr",
   "s": 28.606,
   "e": 35.504,
   "text": "Three years ago, on that bridge, I held a stranger's hand until the ambulance came."
  },
  {
   "id": "n6",
   "who": "mira",
   "kind": "narr",
   "s": 35.804,
   "e": 37.953,
   "text": "It was him. Arjun."
  },
  {
   "id": "n7",
   "who": "mira",
   "kind": "narr",
   "s": 38.173,
   "e": 40.145,
   "text": "That night. 11:11."
  },
  {
   "id": "k4",
   "who": "kabir",
   "kind": "note",
   "s": 40.565,
   "e": 45.795,
   "text": "Now you know. You were there that night. That's why it has to be you."
  }
 ]
}