 "lines": [
  {
   "id": "h0",
   "who": "kabir",
   "kind": "live",
   "s": 0.25,
   "e": 2.684,
   "text": "Whatever happens... don't let go."
  },
  {
   "id": "n1",
   "who": "mira",
   "kind": "narr",
   "s": 3.234,
   "e": 6.555,
   "text": "Day seven. We didn't leave each other's side."
  },
  {
   "id": "n2",
   "who": "mira",
   "kind": "narr",
   "s": 6.675,
   "e": 12.134,
   "text": "Coffee. The café. His laugh. Like there was no tomorrow."
  },
  {
   "id": "n3",
   "who": "mira",
   "kind": "narr",
   "s": 12.254,
   "e": 17.8,
   "text": "Then the rain came. At eleven, his phone buzzed. Arjun's number."
  },
  {
   "id": "k1",
   "who": "kabir",
   "kind": "live",
   "s": 17.92,
   "e": 20.526,
   "text": "It's... a voice note. From me."
  },
  {
   "id": "k2",
   "who": "kabir",
   "kind": "note",
   "s": 20.946,
   "e": 27.035,
   "text": "If she's with you on the bridge, she lives. If she isn't... you do. Choose her."
  },
  {
   "id": "n4",
   "who": "mira",
   "kind": "narr",
   "s": 27.195,
   "e": 28.985,
   "text": "He'd already chosen."
  },
  {
   "id": "k3",
   "who": "kabir",
   "kind": "live",
   "s": 29.105,
   "e": 31.539,
   "text": "Whatever happens... don't let go."
  },
  {
   "id": "n5",
   "who": "mira",
   "kind": "narr",
   "s": 31.659,
   "e": 35.002,
   "text": "11:10. The bridge. Headlights out of the rain."
  },
  {
   "id": "n6",
   "who": "mira",
   "kind": "narr",
   "s": 35.302,
   "e": 38.785,
   "text": "He pushed me back. Just like the first time."
  },
  {
   "id": "n7",
   "who": "mira",
   "kind": "narr",
   "s": 39.005,
   "e": 39.943,
   "text": "11:11."
  },
  {
   "id": "n8",
   "who": "mira",
   "kind": "narr",
   "s": 41.743,
   "e": 44.83,
   "text": "Then... his watch started ticking."
  }
 ]
}