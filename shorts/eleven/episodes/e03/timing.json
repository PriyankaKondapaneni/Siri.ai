   "s": 10,
   "e": 15.43,
   "text": "A mechanical watch doesn't stop by itself. Someone has to stop winding it."
  },
  {
   "id": "bk5",
   "who": "kabir",
   "kind": "live",
   "s": 15.73,
   "e": 19.98,
   "text": "11:11. Three years ago. The night he didn't come home."
  },
  {
   "id": "bk6",
   "who": "kabir",
   "kind": "live",
   "s": 21.78,
   "e": 22.97,
   "text": "Get home safe."
  },
  {
   "id": "bn4",
   "who": "mira",
   "kind": "narr",
   "s": 23.27,
   "e": 26.62,
   "text": "He said it like it was the easiest thing in the world."
  },
  {
   "id": "dn1",
   "who": "mira",
   "kind": "narr",
   "s": 27.52,
   "e": 31.08,
   "text": "I took the long way home. I didn't ask myself why."
  },
  {
   "id": "dn2",
   "who": "mira",
   "kind": "narr",
   "s": 31.38,
   "e": 38.19,
   "text": "Eleven-oh-nine. My phone was already face-up on the pillow. I told myself I wasn't waiting for anything."
  },
  {
   "id": "ck2",
   "who": "kabir",
   "kind": "note",
   "s": 39.59,
   "e": 45.33,
   "text": "Mira. You found me, didn't you? Tomorrow... don't let me get on the 6:40 a.m. train."
  },
  {
   "id": "cm1",
   "who": "mira",
   "kind": "live",
   "s": 45.83,
   "e": 46.78,
   "text": "Why?"
  },
  {
   "id": "ck3",
   "who": "kabir",
   "kind": "note",
   "s": 47.38,
   "e": 50.86,
   "text": "Because if I do... you're the one who doesn't come home."
  }
 ]
}