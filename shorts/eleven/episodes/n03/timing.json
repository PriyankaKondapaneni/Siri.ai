 "lines": [
  {
   "id": "h0",
   "who": "kabir",
   "kind": "live",
   "s": 0.25,
   "e": 1.77,
   "text": "It was my brother's."
  },
  {
   "id": "m1",
   "who": "mira",
   "kind": "live",
   "s": 2.07,
   "e": 3.42,
   "text": "You left this."
  },
  {
   "id": "k1",
   "who": "kabir",
   "kind": "live",
   "s": 3.72,
   "e": 7.53,
   "text": "You followed a bus in the rain. For an umbrella."
  },
  {
   "id": "m2",
   "who": "mira",
   "kind": "live",
   "s": 7.83,
   "e": 9.83,
   "text": "It looked expensive."
  },
  {
   "id": "k2",
   "who": "kabir",
   "kind": "live",
   "s": 10.13,
   "e": 11.08,
   "text": "It isn't."
  },
  {
   "id": "m3",
   "who": "mira",
   "kind": "live",
   "s": 11.38,
   "e": 13.54,
   "text": "Then it looked important."
  },
  {
   "id": "k3",
   "who": "kabir",
   "kind": "live",
   "s": 13.84,
   "e": 15.36,
   "text": "It was my brother's."
  },
  {
   "id": "n1",
   "who": "mira",
   "kind": "narr",
   "s": 15.91,
   "e": 21.29,
   "text": "The name stitched inside the strap said Arjun. Not his, then."
  },
  {
   "id": "k4",
   "who": "kabir",
   "kind": "live",
   "s": 21.41,
   "e": 23.7,
   "text": "You're soaked. I'll make tea."
  },
  {
   "id": "m4",
   "who": "mira",
   "kind": "live",
   "s": 24,
   "e": 25.43,
   "text": "You don't have to."
  },
  {
   "id": "k5",
   "who": "kabir",
   "kind": "live",
   "s": 25.73,
   "e": 26.6,
   "text": "I know."
  }
 ]
