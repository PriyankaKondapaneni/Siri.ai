 "lines": [
  {
   "id": "h0",
   "who": "kabir",
   "kind": "note",
   "s": 0.06,
   "e": 1.999,
   "text": "Don't let me get on the train."
  },
  {
   "id": "n1",
   "who": "mira",
   "kind": "narr",
   "s": 2.549,
   "e": 7.289,
   "text": "Six days left. I spent the whole day watching the clock."
  },
  {
   "id": "n2",
   "who": "mira",
   "kind": "narr",
   "s": 7.639,
   "e": 12.039,
   "text": "Same corner. 6:40. And there he was."
  },
  {
   "id": "k1",
   "who": "kabir",
   "kind": "live",
   "s": 12.289,
   "e": 17.212,
   "text": "Hey... you're the girl from the crosswalk. The car almost got you."
  },
  {
   "id": "n3",
   "who": "mira",
   "kind": "narr",
   "s": 17.512,
   "e": 21.832,
   "text": "He remembered the car... but not one of his messages."
  },
  {
   "id": "k2",
   "who": "kabir",
   "kind": "live",
   "s": 22.132,
   "e": 24.033,
   "text": "I'm Kabir. Coffee?"
  },
  {
   "id": "n4a",
   "who": "mira",
   "kind": "narr",
   "s": 24.583,
   "e": 29.373,
   "text": "We both reached for the last cookie... and neither of us let go."
  },
  {
   "id": "k6",
   "who": "kabir",
   "kind": "live",
   "s": 29.673,
   "e": 32.003,
   "text": "Half? ...You can have the bigger one."
  },
  {
   "id": "m2",
   "who": "mira",
   "kind": "live",
   "s": 32.253,
   "e": 34.813,
   "text": "Then why are you still holding it?"
  },
  {
   "id": "n4",
   "who": "mira",
   "kind": "narr",
   "s": 35.763,
   "e": 38.803,
   "text": "We talked until they closed the café."
  },
  {
   "id": "n5",
   "who": "mira",
   "kind": "narr",
   "s": 39.053,
   "e": 43.443,
   "text": "Then I noticed his watch. Stopped at 11:11."
  },
  {
   "id": "k3",
   "who": "kabir",
   "kind": "live",
   "s": 43.693,
   "e": 47.443,
   "text": "It stopped the night my brother died. I never fixed it."
  },
  {
   "id": "n5b",
   "who": "mira",
   "kind": "narr",
   "s": 47.793,
   "e": 52.593,
   "text": "We said goodbye at the door. I smiled the whole way home."
  },
  {
   "id": "n6",
   "who": "mira",
   "kind": "narr",
   "s": 53.093,
   "e": 56.683,
   "text": "At 11:11… my phone lit up."
  },
  {
   "id": "k4",
   "who": "kabir",
   "kind": "note",
   "s": 57.103,
   "e": 62.732,
   "text": "Mira. You found me, didn't you? Tomorrow... don't let me get on the train."
  },
  {
   "id": "m3",
   "who": "mira",
   "kind": "narr",
   "s": 63.132,
   "e": 64.572,
   "text": "Why...?"
  },
  {
   "id": "k5",
   "who": "kabir",
   "kind": "note",
   "s": 65.072,
   "e": 70.352,
   "text": "Because if I get on that train... you're the one who doesn't come home."
  }
 ]
}