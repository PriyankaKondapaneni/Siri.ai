 "lines": [
  {
   "id": "h0",
   "who": "kabir",
   "kind": "note",
   "s": 0.25,
   "e": 2.101,
   "text": "Don't let me get on the train."
  },
  {
   "id": "n1",
   "who": "mira",
   "kind": "narr",
   "s": 2.651,
   "e": 8.786,
   "text": "Six days left. He told me not to fall for him... so I went looking for him."
  },
  {
   "id": "n2",
   "who": "mira",
   "kind": "narr",
   "s": 8.906,
   "e": 13.142,
   "text": "Same corner. 6:40. And there he was."
  },
  {
   "id": "k1",
   "who": "kabir",
   "kind": "live",
   "s": 13.262,
   "e": 16.793,
   "text": "You again. The girl who almost got hit by a car."
  },
  {
   "id": "n3",
   "who": "mira",
   "kind": "narr",
   "s": 16.913,
   "e": 21.137,
   "text": "He remembered the car. But not a single message."
  },
  {
   "id": "k2",
   "who": "kabir",
   "kind": "live",
   "s": 21.257,
   "e": 24.816,
   "text": "I'm Kabir, by the way. Coffee? You look like you need one."
  },
  {
   "id": "n4",
   "who": "mira",
   "kind": "narr",
   "s": 24.936,
   "e": 30.611,
   "text": "We talked until they closed the café. He laughed like he'd known me forever."
  },
  {
   "id": "n5",
   "who": "mira",
   "kind": "narr",
   "s": 30.731,
   "e": 34.855,
   "text": "Then I noticed his watch. Still stopped at 11:11."
  },
  {
   "id": "k3",
   "who": "kabir",
   "kind": "live",
   "s": 34.975,
   "e": 38.358,
   "text": "It stopped the night my brother died. I never fixed it."
  },
  {
   "id": "n6",
   "who": "mira",
   "kind": "narr",
   "s": 38.658,
   "e": 42.882,
   "text": "That night, at 11:11… my phone lit up."
  },
  {
   "id": "k4",
   "who": "kabir",
   "kind": "note",
   "s": 43.302,
   "e": 49.494,
   "text": "Mira. You found me, didn't you? Listen. Tomorrow... don't let me get on the train."
  },
  {
   "id": "n7",
   "who": "mira",
   "kind": "narr",
   "s": 49.714,
   "e": 51.648,
   "text": "Don't let him get on the train?"
  },
  {
   "id": "k5",
   "who": "kabir",
   "kind": "note",
   "s": 52.068,
   "e": 56.691,
   "text": "If I get on that train... you're the one who doesn't come home."
  }
 ]
}