 "lines": [
  {
   "id": "h0",
   "who": "kabir",
   "kind": "note",
   "s": 0.06,
   "e": 1.994,
   "text": "Don't let me get on the train."
  },
  {
   "id": "n1",
   "who": "mira",
   "kind": "narr",
   "s": 2.544,
   "e": 8.704,
   "text": "Six days left. He told me not to fall for him... so I went looking for him."
  },
  {
   "id": "n2",
   "who": "mira",
   "kind": "narr",
   "s": 8.824,
   "e": 12.911,
   "text": "Same corner. 6:40. And there he was."
  },
  {
   "id": "k1",
   "who": "kabir",
   "kind": "live",
   "s": 13.031,
   "e": 16.562,
   "text": "You again. The girl who almost got hit by a car."
  },
  {
   "id": "n3",
   "who": "mira",
   "kind": "narr",
   "s": 16.682,
   "e": 20.764,
   "text": "He remembered the car. But not a single message."
  },
  {
   "id": "k2",
   "who": "kabir",
   "kind": "live",
   "s": 20.884,
   "e": 24.601,
   "text": "I'm Kabir, by the way. Coffee? You look like you need one."
  },
  {
   "id": "n4a",
   "who": "mira",
   "kind": "narr",
   "s": 24.721,
   "e": 30.804,
   "text": "We both reached for the last cookie. Our fingers touched... and neither of us let go."
  },
  {
   "id": "k6",
   "who": "kabir",
   "kind": "live",
   "s": 30.924,
   "e": 33.136,
   "text": "Half? ...You can have the bigger one."
  },
  {
   "id": "n4b",
   "who": "mira",
   "kind": "narr",
   "s": 33.256,
   "e": 37.005,
   "text": "He gave me the bigger half. Then stole a bite of it."
  },
  {
   "id": "n4",
   "who": "mira",
   "kind": "narr",
   "s": 37.125,
   "e": 42.508,
   "text": "We talked until they closed the café. He laughed like he'd known me forever."
  },
  {
   "id": "n5",
   "who": "mira",
   "kind": "narr",
   "s": 42.628,
   "e": 47.122,
   "text": "Then I noticed his watch. Still stopped at 11:11."
  },
  {
   "id": "k3",
   "who": "kabir",
   "kind": "live",
   "s": 47.242,
   "e": 50.699,
   "text": "It stopped the night my brother died. I never fixed it."
  },
  {
   "id": "n6",
   "who": "mira",
   "kind": "narr",
   "s": 50.999,
   "e": 55.06,
   "text": "That night, at 11:11… my phone lit up."
  },
  {
   "id": "k4",
   "who": "kabir",
   "kind": "note",
   "s": 55.48,
   "e": 61.495,
   "text": "Mira. You found me, didn't you? Listen. Tomorrow... don't let me get on the train."
  },
  {
   "id": "n7",
   "who": "mira",
   "kind": "narr",
   "s": 61.715,
   "e": 63.671,
   "text": "Don't let him get on the train?"
  },
  {
   "id": "k5",
   "who": "kabir",
   "kind": "note",
   "s": 64.091,
   "e": 68.368,
   "text": "If I get on that train... you're the one who doesn't come home."
  }
 ]
}