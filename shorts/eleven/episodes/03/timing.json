 "lines": [
  {
   "id": "h0",
   "who": "kabir",
   "kind": "note",
   "s": 0.06,
   "e": 1.999,
   "text": "Don't let me get on the train."
  },
  {
   "id": "t1",
   "who": "mira",
   "kind": "narr",
   "s": 2.449,
   "e": 5.949,
   "text": "6:31. Nine minutes."
  },
  {
   "id": "t2",
   "who": "mira",
   "kind": "narr",
   "s": 6.249,
   "e": 8.969,
   "text": "...and he had no idea."
  },
  {
   "id": "k1",
   "who": "kabir",
   "kind": "live",
   "s": 9.319,
   "e": 10.439,
   "text": "You again."
  },
  {
   "id": "m8",
   "who": "mira",
   "kind": "live",
   "s": 10.739,
   "e": 12.369,
   "text": "Hi... again."
  },
  {
   "id": "k11",
   "who": "kabir",
   "kind": "live",
   "s": 12.669,
   "e": 14.429,
   "text": "Do you take this train too?"
  },
  {
   "id": "m9",
   "who": "mira",
   "kind": "live",
   "s": 14.679,
   "e": 15.869,
   "text": "Every day."
  },
  {
   "id": "t3",
   "who": "mira",
   "kind": "narr",
   "s": 16.169,
   "e": 19.529,
   "text": "I'd never taken this train in my life."
  },
  {
   "id": "k3",
   "who": "kabir",
   "kind": "live",
   "s": 20.129,
   "e": 21.808,
   "text": "Well. That's mine."
  },
  {
   "id": "t4",
   "who": "mira",
   "kind": "narr",
   "s": 22.108,
   "e": 24.728,
   "text": "Ten seconds. No plan."
  },
  {
   "id": "m5",
   "who": "mira",
   "kind": "live",
   "s": 24.978,
   "e": 26.808,
   "text": "Oh no... my earring!"
  },
  {
   "id": "k8",
   "who": "kabir",
   "kind": "live",
   "s": 27.108,
   "e": 29.468,
   "text": "Don't move. What does it look like?"
  },
  {
   "id": "m6",
   "who": "mira",
   "kind": "live",
   "s": 29.768,
   "e": 33.208,
   "text": "Small. Gold. A little flower."
  },
  {
   "id": "t10",
   "who": "mira",
   "kind": "narr",
   "s": 33.658,
   "e": 36.008,
   "text": "Don't look up. Don't look up."
  },
  {
   "id": "k9",
   "who": "kabir",
   "kind": "live",
   "s": 37.158,
   "e": 39.404,
   "text": "I can't find it. I'm sorry."
  },
  {
   "id": "m7",
   "who": "mira",
   "kind": "live",
   "s": 39.754,
   "e": 42.824,
   "text": "It's okay. Maybe it was never here."
  },
  {
   "id": "k10",
   "who": "kabir",
   "kind": "live",
   "s": 43.324,
   "e": 44.914,
   "text": "...And there goes my train."
  },
  {
   "id": "t11",
   "who": "mira",
   "kind": "narr",
   "s": 45.264,
   "e": 48.804,
   "text": "The earring was in my pocket the whole time."
  },
  {
   "id": "t6",
   "who": "mira",
   "kind": "narr",
   "s": 49.504,
   "e": 55.084,
   "text": "Forty minutes later, every phone in the café lit up at once."
  },
  {
   "id": "t7",
   "who": "mira",
   "kind": "narr",
   "s": 55.384,
   "e": 58.844,
   "text": "The 6:40 never made it to the next station."
  },
  {
   "id": "k5",
   "who": "kabir",
   "kind": "live",
   "s": 59.194,
   "e": 61.194,
   "text": "You knew. Didn't you?"
  },
  {
   "id": "t9",
   "who": "mira",
   "kind": "narr",
   "s": 61.644,
   "e": 65.704,
   "text": "That night, at 11:11… it wasn't my phone that lit up."
  },
  {
   "id": "k6",
   "who": "kabir",
   "kind": "live",
   "s": 66.104,
   "e": 69.404,
   "text": "Mira... why is your voice on my phone?"
  }
 ]
