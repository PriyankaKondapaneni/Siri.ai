   "kind": "narr",
   "s": 7.027,
   "e": 10.78,
   "text": "6:30. Platform four. He was already there."
  },
  {
   "id": "k1",
   "who": "kabir",
   "kind": "live",
   "s": 10.9,
   "e": 12.946,
   "text": "Mira? What are you doing here?"
  },
  {
   "id": "n3",
   "who": "mira",
   "kind": "narr",
   "s": 13.066,
   "e": 18.475,
   "text": "I didn't have a plan. So I spilled my coffee... all over him."
  },
  {
   "id": "k2",
   "who": "kabir",
   "kind": "live",
   "s": 18.595,
   "e": 22.549,
   "text": "Okay. That's twice now. Are you doing this on purpose?"
  },
  {
   "id": "n4",
   "who": "mira",
   "kind": "narr",
   "s": 22.669,
   "e": 28.011,
   "text": "The doors closed. The train left without him. I didn't let go of his hand."
  },
  {
   "id": "n5",
   "who": "mira",
   "kind": "narr",
   "s": 28.131,
   "e": 32.917,
   "text": "An hour later, every phone on the street buzzed at once."
  },
  {
   "id": "n6",
   "who": "mira",
   "kind": "narr",
   "s": 33.217,
   "e": 37.454,
   "text": "The 6:40 train… never made it to the next station."
  },
  {
   "id": "k3",
   "who": "kabir",
   "kind": "live",
   "s": 37.574,
   "e": 39.323,
   "text": "You knew. Didn't you?"
  },
  {
   "id": "n7",
   "who": "mira",
   "kind": "narr",
   "s": 39.543,
   "e": 42.186,
   "text": "I couldn't tell him. Not yet."
  },
  {
   "id": "n8",
   "who": "mira",
   "kind": "narr",
   "s": 42.366,
   "e": 46.897,
   "text": "That night, at 11:11… it wasn't my phone that lit up."
  },
  {
   "id": "k4",
   "who": "kabir",
   "kind": "live",
   "s": 47.017,
   "e": 49.956,
   "text": "Mira... why is your voice on my phone?"
  }
 ]
