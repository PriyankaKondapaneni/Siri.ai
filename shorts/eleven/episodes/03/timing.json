 "lines": [
  {
   "id": "h0",
   "who": "kabir",
   "kind": "note",
   "s": 0.06,
   "e": 1.999,
   "text": "Don't let me get on the train."
  },
  {
   "id": "t1",
   "who": "mira",
   "kind": "narr",
   "s": 2.449,
   "e": 5.529,
   "text": "6:31. Nine minutes."
  },
  {
   "id": "t2",
   "who": "mira",
   "kind": "narr",
   "s": 5.879,
   "e": 8.189,
   "text": "...and he had no idea."
  },
  {
   "id": "k1",
   "who": "kabir",
   "kind": "live",
   "s": 8.539,
   "e": 9.659,
   "text": "You again."
  },
  {
   "id": "t3",
   "who": "mira",
   "kind": "narr",
   "s": 10.009,
   "e": 13.369,
   "text": "I'd never taken this train in my life."
  },
  {
   "id": "k3",
   "who": "kabir",
   "kind": "live",
   "s": 14.169,
   "e": 15.848,
   "text": "Well. That's mine."
  },
  {
   "id": "t4",
   "who": "mira",
   "kind": "narr",
   "s": 16.148,
   "e": 18.588,
   "text": "Ten seconds. No plan."
  },
  {
   "id": "m5",
   "who": "mira",
   "kind": "live",
   "s": 18.838,
   "e": 20.668,
   "text": "Oh no... my earring!"
  },
  {
   "id": "k8",
   "who": "kabir",
   "kind": "live",
   "s": 20.968,
   "e": 23.328,
   "text": "Don't move. What does it look like?"
  },
  {
   "id": "m6",
   "who": "mira",
   "kind": "live",
   "s": 23.628,
   "e": 27.068,
   "text": "Small. Gold. A little flower."
  },
  {
   "id": "t10",
   "who": "mira",
   "kind": "narr",
   "s": 27.518,
   "e": 29.948,
   "text": "Don't look up. Don't look up."
  },
  {
   "id": "k9",
   "who": "kabir",
   "kind": "live",
   "s": 31.548,
   "e": 33.794,
   "text": "I can't find it. I'm sorry."
  },
  {
   "id": "m7",
   "who": "mira",
   "kind": "live",
   "s": 34.144,
   "e": 37.214,
   "text": "It's okay. Maybe it was never here."
  },
  {
   "id": "k10",
   "who": "kabir",
   "kind": "live",
   "s": 37.714,
   "e": 39.304,
   "text": "...And there goes my train."
  },
  {
   "id": "t11",
   "who": "mira",
   "kind": "narr",
   "s": 39.754,
   "e": 43.294,
   "text": "The earring was in my pocket the whole time."
  },
  {
   "id": "t6",
   "who": "mira",
   "kind": "narr",
   "s": 44.194,
   "e": 49.674,
   "text": "Forty minutes later, every phone in the café lit up at once."
  },
  {
   "id": "t7",
   "who": "mira",
   "kind": "narr",
   "s": 49.974,
   "e": 53.804,
   "text": "The 6:40 never made it to the next station."
  },
  {
   "id": "k5",
   "who": "kabir",
   "kind": "live",
   "s": 54.154,
   "e": 56.154,
   "text": "You knew. Didn't you?"
  },
  {
   "id": "t8",
   "who": "mira",
   "kind": "narr",
   "s": 56.504,
   "e": 59.414,
   "text": "I couldn't tell him. Not yet."
  },
  {
   "id": "t9",
   "who": "mira",
   "kind": "narr",
   "s": 59.914,
   "e": 65.234,
   "text": "That night, at 11:11… it wasn't my phone that lit up."
  },
  {
   "id": "k6",
   "who": "kabir",
   "kind": "live",
   "s": 65.634,
   "e": 68.934,
   "text": "Mira... why is your voice on my phone?"
  }
 ]
