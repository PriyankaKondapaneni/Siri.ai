 "lines": [
  {
   "id": "hook",
   "s": 0.16,
   "e": 5.28,
   "text": "She sent him forty-seven paper planes... before she ever heard his voice."
  },
  {
   "id": "one",
   "s": 5.68,
   "e": 7.68,
   "text": "This is plane number one."
  },
  {
   "id": "mira",
   "s": 8.08,
   "e": 12.88,
   "text": "Mira was twenty-two, on the fifth floor of a city that never noticed her."
  },
  {
   "id": "lamp",
   "s": 13.6,
   "e": 19.52,
   "text": "Across the alley, a stranger kept his lamp on until two a.m. Every single night."
  },
  {
   "id": "fold",
   "s": 19.92,
   "e": 24.16,
   "text": "One night, she folded her grocery list into a plane... and threw it."
  },
  {
   "id": "land",
   "s": 24.56,
   "e": 26.64,
   "text": "It landed right on his windowsill."
  },
  {
   "id": "off",
   "s": 27.04,
   "e": 30.48,
   "text": "His lamp went off. Great. She'd scared him."
  },
  {
   "id": "back",
   "s": 30.88,
   "e": 33.28,
   "text": "But the next morning... it flew back."
  },
  {
   "id": "drawing",
   "s": 33.6,
   "e": 37.36,
   "text": "On the back of her list, he'd drawn her. Badly."
  },
  {
   "id": "question",
   "s": 37.68,
   "e": 41.2,
   "text": "And underneath... a tiny lamp, and a question mark."
  },
  {
   "id": "hi",
   "s": 41.6,
   "e": 46.72,
   "text": "So that night, she folded plane number two. Just one word. Hi."
  },
  {
   "id": "wind",
   "s": 47.12,
   "e": 52.08,
   "text": "But the wind had other plans. It dropped five floors, into the alley..."
  },
  {
   "id": "someone",
   "s": 52.4,
   "e": 55.6,
   "text": "where someone picked it up. And it wasn't him."
  }
 ]
}